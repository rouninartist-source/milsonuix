---
import { posts } from "../data/posts";
import PostCard from "./PostCard.astro";
import Button from "./Button.astro";
import SectionRule from "./SectionRule.astro";
const latest = posts.slice(0, 3);
---
<section class="container section journal">
  <SectionRule n="04" label="Journal" />
  <div class="journal__head">
    <h2 class="statement" data-reveal>{latest[0].title}</h2>
    <Button href="/journal" icon="enter" size="sm">View all posts</Button>
  </div>
  <div class="scroller journal__cards">
    {latest.map((p) => <PostCard post={p} />)}
  </div>
</section>

<style>
  .journal__head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 16px 32px; margin-block: clamp(28px, 4vw, 56px) 28px; }
  .journal__head h2 { max-width: 22ch; }
</style>
