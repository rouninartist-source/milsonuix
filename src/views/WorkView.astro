---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Cta from "../components/Cta.astro";
import { img, pillars } from "../data/site";
import { projects } from "../data/projects";
import { ui, pick, type Lang } from "../data/i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
---
<Base lang={lang} title={t.pages.work} description={t.workPage.intro}>
  <PageHero word={t.workPage.title} image={img("milson-work-hero", 1800, 900)} intro={t.workPage.intro}>
    <div class="work__filter" data-filter>
      <button type="button" class="chip work__chip is-active" data-f="all">{t.workPage.all}</button>
      {pillars.map((p) => <button type="button" class="chip work__chip" data-f={p.id}>{pick(p.label, lang)}</button>)}
      <span class="small muted work__count"><span data-count>{String(projects.length).padStart(2, "0")}</span> {t.workPage.projects}</span>
    </div>
  </PageHero>

  <section class="container section--tight">
    <div class="work__grid">
      {projects.map((p, i) => <ProjectCard project={p} lang={lang} index={i} />)}
    </div>
  </section>

  <Cta lang={lang} />
</Base>

<style>
  .work__filter { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: clamp(24px, 3vw, 40px); }
  .work__chip { height: 32px; padding-inline: 14px; font-size: 12px; transition: background 0.3s, color 0.3s, border-color 0.3s; }
  .work__chip:hover { border-color: var(--ink); color: var(--ink); }
  .work__chip.is-active { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .work__count { margin-left: auto; font-variant-numeric: tabular-nums; }
  .work__grid { display: grid; gap: var(--gutter); }
  @media (min-width: 700px) { .work__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
