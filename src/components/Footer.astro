---
import { site, pillars } from "../data/site";
import Icon from "./Icon.astro";
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="grid footer__cols">
      <div class="footer__col">
        <p class="eyebrow">{site.brand}</p>
        <ul>
          {site.nav.filter((n) => n.href !== "/").map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </div>
      <div class="footer__col">
        <p class="eyebrow">Practice</p>
        <ul>
          {pillars.map((p, i) => <li><a href={`/work?f=${p.id}`} class:list={{ blue: i === 0 }}>{p.label}</a></li>)}
        </ul>
      </div>
      <div class="footer__col">
        <p class="eyebrow">Contact</p>
        <ul>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href="/contact">Start a project</a></li>
          <li><span class="muted">{site.location}</span></li>
        </ul>
      </div>
      <ul class="footer__socials">
        {site.socials.map((s) => (
          <li><a href={s.href} target="_blank" rel="noopener" aria-label={s.label}><Icon name={s.short as "li"} size={13} /></a></li>
        ))}
      </ul>
    </div>

    <p class="footer__giant display" aria-hidden="true">{site.brand}</p>

    <div class="footer__bar small">
      <span class="muted">Designed and built by {site.brand}</span>
      <span class="muted">© {site.brand} {year}. All rights reserved.</span>
    </div>
  </div>
</footer>

<style>
  .footer { padding-top: clamp(56px, 8vw, 120px); background: linear-gradient(to bottom, var(--bg), var(--obsidian)); overflow: hidden; }
  .footer__cols { row-gap: 32px; }
  .footer__col { grid-column: span 3; }
  .footer__col ul { display: grid; gap: 6px; margin-top: 14px; font-size: 13px; }
  .footer__col a { color: var(--ink-2); transition: color 0.25s; }
  .footer__col a:hover { color: var(--frost); }
  .footer__col a.blue { color: var(--blue); }
  .footer__socials { grid-column: 10 / -1; display: flex; gap: 6px; justify-content: flex-end; align-self: start; }
  .footer__socials a {
    display: grid; place-items: center; width: 32px; height: 32px;
    border: 1px solid var(--line); border-radius: 50%; color: var(--ink-2);
    transition: background 0.3s, color 0.3s, border-color 0.3s;
  }
  .footer__socials a:hover { background: var(--frost); color: var(--obsidian); border-color: var(--frost); }
  @media (max-width: 899px) {
    .footer__col { grid-column: span 3; }
    .footer__socials { grid-column: 1 / -1; justify-content: flex-start; }
  }

  .footer__giant {
    margin-top: clamp(48px, 8vw, 120px);
    font-size: clamp(88px, 17.5vw, 262px);
    line-height: 0.78;
    color: rgb(26 44 70 / 0.55);
    white-space: nowrap;
    -webkit-mask-image: linear-gradient(to bottom, #000 30%, transparent 95%);
    mask-image: linear-gradient(to bottom, #000 30%, transparent 95%);
    margin-bottom: -0.12em;
    user-select: none;
  }
  .footer__bar { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; padding-block: 20px 24px; border-top: 1px solid var(--line); }
</style>
