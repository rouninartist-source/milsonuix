---
/** Full-width image band, faded top and bottom into the page. */
interface Props { src: string; alt?: string; ratio?: string }
const { src, alt = "", ratio = "16 / 7" } = Astro.props;
---
<figure class="bleed fade-y" style={`--ratio:${ratio}`} data-reveal>
  <img src={src} alt={alt} loading="lazy" />
</figure>

<style>
  .bleed { margin: 0; width: 100%; aspect-ratio: var(--ratio); overflow: hidden; }
  .bleed img { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.7) saturate(0.85); }
</style>
