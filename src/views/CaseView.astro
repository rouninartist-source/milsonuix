---
import Base from "../layouts/Base.astro";
import SectionRule from "../components/SectionRule.astro";
import Button from "../components/Button.astro";
import { projects, type Project } from "../data/projects";
import { ui, href, pick, type Lang } from "../data/i18n";
interface Props { lang: Lang; project: Project }
const { lang, project } = Astro.props;
const t = ui[lang];
const i = projects.findIndex((p) => p.slug === project.slug);
const next = projects[(i + 1) % projects.length];
---
<Base lang={lang} title={project.title} description={pick(project.summary, lang)} image={project.cover}>
  <section class="container case__hero">
    <p class="eyebrow" data-reveal>{pick(project.categoryLabel, lang)} · {project.year}</p>
    <h1 class="display case__title" style={`--chars:${project.title.length}`} data-reveal>
      <span class="masked" style={`background-image:url(${project.cover})`}>{project.title}</span>
    </h1>
    <div class="grid case__meta" data-reveal style="--delay:120ms">
      <p class="statement case__intro">{pick(project.intro, lang)}</p>
      <dl class="case__facts small">
        <div><dt class="eyebrow">{t.workPage.client}</dt><dd>{pick(project.client, lang)}</dd></div>
        <div><dt class="eyebrow">{t.workPage.role}</dt><dd>{pick(project.role, lang)}</dd></div>
        <div><dt class="eyebrow">{t.workPage.services}</dt><dd>{pick(project.services, lang).join(", ")}</dd></div>
      </dl>
    </div>
  </section>

  <figure class="container case__cover" data-reveal>
    <img src={project.cover} alt={`${project.title} cover`} class="media media--wide" />
  </figure>

  {project.sections.map((s, n) => (
    <section class="container section--tight case__section">
      <SectionRule n={String(n + 1).padStart(2, "0")} label={pick(s.label, lang)} />
      <p class="statement case__text" data-reveal>{pick(s.text, lang)}</p>
      <div class:list={["case__images", { "case__images--pair": s.images.length > 1 }]}>
        {s.images.map((src) => (
          <figure class="media" data-reveal>
            <img src={src} alt="" loading="lazy" />
          </figure>
        ))}
      </div>
    </section>
  ))}

  <section class="container section case__next">
    <p class="eyebrow">{t.workPage.next}</p>
    <a href={href(lang, `/work/${next.slug}`)} class="display case__next-title">{next.title}</a>
    <div class="case__next-actions">
      <Button href={href(lang, `/work/${next.slug}`)} icon="arrow">{t.workPage.view}</Button>
      <Button href={href(lang, "/work")} icon="enter" variant="ghost">{t.workPage.allProjects}</Button>
    </div>
  </section>
</Base>

<style>
  .case__hero { padding-top: calc(var(--nav-h) + clamp(32px, 8vh, 96px)); display: grid; gap: 20px; }
  .case__title { overflow: hidden; margin-inline: -0.03em; font-size: min(calc((100vw - 2 * var(--margin)) / (var(--chars) * 0.56)), 300px); }
  .case__title .masked { padding-inline: 0.03em; }
  .case__meta { row-gap: 28px; margin-top: 12px; }
  .case__intro { grid-column: 1 / -1; max-width: 30ch; }
  .case__facts { grid-column: 1 / -1; display: grid; gap: 14px; align-content: start; }
  .case__facts div { display: grid; gap: 4px; }
  .case__facts dd { margin: 0; color: var(--ink-2); }
  @media (min-width: 900px) {
    .case__intro { grid-column: 1 / span 7; }
    .case__facts { grid-column: 9 / -1; }
  }
  .case__cover { margin: clamp(32px, 5vw, 72px) auto 0; }
  .case__cover img { aspect-ratio: 16 / 8; }
  .case__section .case__text { max-width: 32ch; margin-block: clamp(24px, 3vw, 40px) clamp(28px, 4vw, 56px); text-align: center; margin-inline: auto; }
  .case__images { display: grid; gap: var(--gutter); }
  .case__images figure { margin: 0; aspect-ratio: 16 / 10; }
  .case__images--pair figure { aspect-ratio: 4 / 5; }
  @media (min-width: 700px) { .case__images--pair { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .case__next { display: grid; gap: 16px; justify-items: start; border-top: 1px solid var(--line); }
  .case__next-title { font-size: clamp(56px, 10vw, 150px); color: var(--ink-4); transition: color 0.3s; line-height: 0.9; }
  .case__next-title:hover { color: var(--blue); }
  .case__next-actions { display: flex; flex-wrap: wrap; gap: 8px; }
</style>
