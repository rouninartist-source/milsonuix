---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Button from "../../components/Button.astro";
import Updates from "../../components/Updates.astro";
import { posts, formatDate } from "../../data/posts";

export function getStaticPaths() {
  return posts.map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}
const { post } = Astro.props;
---
<Base title={post.title} description={post.excerpt} image={post.cover}>
  <article class="container post">
    <div class="post__chips" data-reveal>
      <span class="chip chip--dot">{post.tag}</span>
      <span class="chip"><Icon name="calendar" />{formatDate(post.date)}</span>
    </div>
    <h1 class="statement--lg post__title" data-reveal>{post.title}</h1>
    <figure class="post__cover media media--wide" data-reveal style="--delay:120ms">
      <img src={post.cover} alt="" />
    </figure>
    <div class="post__body" data-reveal>
      <p class="lede">{post.excerpt}</p>
      {post.body.map((p) => <p class="body">{p}</p>)}
    </div>
    <div class="post__foot">
      <Button href="/journal" icon="enter" variant="ghost">Back to journal</Button>
    </div>
  </article>
  <Updates />
</Base>

<style>
  .post { padding-top: calc(var(--nav-h) + clamp(32px, 8vh, 96px)); display: grid; gap: 24px; max-width: 880px; }
  .post__chips { display: flex; gap: 6px; }
  .post__title { max-width: 20ch; }
  .post__cover { margin: 12px 0 0; }
  .post__body { display: grid; gap: 20px; max-width: 62ch; font-size: 16px; }
  .post__foot { padding-top: 12px; }
</style>
