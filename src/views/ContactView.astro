---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import { img, site, pillars } from "../data/site";
import { ui, pick, type Lang } from "../data/i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const c = t.contactPage;
---
<Base lang={lang} title={t.pages.contact} description={c.intro}>
  <PageHero word={c.title} image={img("milson-contact-hero", 1800, 900, true)} intro={c.intro} />

  <section class="container section--tight">
    <div class="grid contact">
      <div class="contact__side" data-reveal>
        <a href={`mailto:${site.email}`} class="contact__mail lede">{site.email}</a>
        <p class="small muted">{pick(site.location, lang)} · {c.tz}</p>
        <ul class="contact__socials">
          {site.socials.map((s) => (
            <li><a href={s.href} target="_blank" rel="noopener" class="small"><Icon name={s.short as "li"} />{s.label}</a></li>
          ))}
        </ul>
      </div>

      <form class="contact__form" data-contact={site.email} data-subject={c.subject} novalidate data-reveal style="--delay:120ms">
        <div class="field">
          <label for="c-name" class="eyebrow">{c.name}</label>
          <input id="c-name" name="name" type="text" required autocomplete="name" />
        </div>
        <div class="field">
          <label for="c-email" class="eyebrow">{c.email}</label>
          <input id="c-email" name="email" type="email" required autocomplete="email" />
        </div>
        <fieldset class="field">
          <legend class="eyebrow">{c.need}</legend>
          <div class="contact__kinds">
            {pillars.map((p) => (
              <label class="kind">
                <input type="checkbox" name="kind" value={pick(p.label, lang)} />
                <span class="chip">{pick(p.label, lang)}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <div class="field">
          <label for="c-msg" class="eyebrow">{c.about}</label>
          <textarea id="c-msg" name="message" rows="5" required placeholder={c.placeholder}></textarea>
        </div>
        <button type="submit" class="btn btn--primary"><Icon name="arrow" />{c.send}</button>
        <p class="small blue" data-sent hidden>{c.sent} {site.email}.</p>
      </form>
    </div>
  </section>
</Base>

<style>
  .contact { row-gap: 48px; padding-top: clamp(16px, 3vw, 40px); }
  .contact__side { grid-column: 1 / -1; display: grid; gap: 12px; align-content: start; }
  .contact__mail { color: var(--frost); transition: color 0.3s; }
  .contact__mail:hover { color: var(--blue); }
  .contact__socials { display: grid; gap: 6px; margin-top: 12px; }
  .contact__socials a { display: inline-flex; align-items: center; gap: 8px; color: var(--ink-2); transition: color 0.3s; }
  .contact__socials a:hover { color: var(--frost); }
  .contact__form { grid-column: 1 / -1; display: grid; gap: 22px; justify-items: start; }
  .field { display: grid; gap: 8px; width: 100%; border: 0; padding: 0; margin: 0; min-width: 0; }
  .field input, .field textarea {
    width: 100%; padding: 12px 0; border: 0; border-bottom: 1px solid var(--line); background: transparent; color: var(--frost);
    border-radius: 0; transition: border-color 0.3s; resize: vertical;
  }
  .field input:focus, .field textarea:focus { outline: 0; border-color: var(--blue); }
  .field textarea::placeholder { color: var(--ink-3); }
  .contact__kinds { display: flex; flex-wrap: wrap; gap: 6px; padding-top: 4px; }
  .kind { position: relative; }
  .kind input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; pointer-events: none; }
  .kind .chip { height: 32px; padding-inline: 14px; font-size: 12px; cursor: pointer; transition: background 0.3s, color 0.3s, border-color 0.3s; }
  .kind input:checked + .chip { background: var(--frost); color: var(--obsidian); border-color: var(--frost); }
  .kind input:focus-visible + .chip { outline: 2px solid var(--blue); outline-offset: 2px; }
  @media (min-width: 900px) {
    .contact__side { grid-column: 1 / span 4; }
    .contact__form { grid-column: 6 / span 7; }
  }
</style>
