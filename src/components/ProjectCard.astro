---
import type { Project } from "../data/projects";
import { ui, href, pick, type Lang } from "../data/i18n";
import Icon from "./Icon.astro";
interface Props { project: Project; lang: Lang; index?: number }
const { project, lang, index = 0 } = Astro.props;
const t = ui[lang];
---
<a href={href(lang, `/work/${project.slug}`)} class="pcard" data-category={project.category} data-reveal style={`--delay:${(index % 2) * 90}ms`}>
  <span class="pcard__media media media--landscape media--scrim">
    <img src={project.cover} alt={`${project.title} — ${pick(project.categoryLabel, lang)}`} loading="lazy" />
  </span>
  <span class="pcard__chips">
    <span class="chip chip--dot">{pick(project.categoryLabel, lang)}</span>
    <span class="chip">{project.year}</span>
  </span>
  <span class="pcard__body">
    <span class="pcard__title display">{project.title}</span>
    <span class="pcard__sum small">{pick(project.summary, lang)}</span>
    <span class="btn btn--sm pcard__cta"><Icon name="enter" />{t.workPage.view}</span>
  </span>
</a>

<style>
  .pcard { position: relative; display: block; border-radius: var(--radius); overflow: hidden; }
  .pcard__media img { filter: brightness(0.82); transition: transform 1.2s var(--ease); }
  .pcard:hover .pcard__media img { transform: scale(1.04); }
  .pcard__chips { position: absolute; top: 12px; left: 12px; display: flex; gap: 6px; }
  .pcard__body { position: absolute; left: 16px; right: 16px; bottom: 16px; display: grid; gap: 8px; }
  .pcard__title { font-size: clamp(34px, 4vw, 56px); color: var(--on-photo); }
  .pcard__sum { color: var(--ink-2); max-width: 40ch; }
  .pcard__cta { justify-self: start; margin-top: 6px; }
</style>
