---
/**
 * Practice areas as a boxed panel with three numbered columns.
 * One column is open; clicking another rail pushes the open one shut
 * (it slides to its rail) and expands the clicked one — a horizontal accordion.
 */
import { pillars, img } from "../data/site";
import { ui, href, pick, type Lang } from "../data/i18n";
import Button from "./Button.astro";
import Icon from "./Icon.astro";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
---
<section class="container section practice">
  <div class="practice__panel" data-accordion data-active="brand">
    {pillars.map((p, i) => (
      <article class="pcol" data-pillar={p.id} aria-expanded="false">
        <button type="button" class="pcol__rail" data-rail={p.id} aria-controls={`pillar-${p.id}`} aria-label={pick(p.label, lang)}>
          <span class="pcol__n">{String(i + 1).padStart(2, "0")}</span>
          <span class="pcol__label">{pick(p.label, lang)}</span>
        </button>
        <div class="pcol__body" id={`pillar-${p.id}`}>
          <div class="pcol__inner">
            <p class="statement pcol__statement">{pick(p.statement, lang)}</p>
            <div class="pcol__lower">
              <a href={`${href(lang, "/work")}?f=${p.id}`} class="pcol__thumb media media--landscape media--scrim">
                <img src={img(p.seed + "-thumb", 800, 500)} alt="" loading="lazy" />
                <span class="btn btn--sm"><Icon name="play" />{t.pillars.see}</span>
              </a>
              <p class="small body">{pick(p.body, lang)}</p>
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>
  <Button href={href(lang, "/work")} icon="arrow" class="practice__all" variant="ghost">{t.pillars.all}</Button>
</section>

<style>
  .practice__all { margin-top: 24px; }

  /* the boxed panel with the blue gloom, like the reference */
  .practice__panel {
    position: relative;
    display: flex;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 14px;
    background:
      radial-gradient(90% 80% at 15% 110%, rgb(0 112 255 / 0.22), transparent 60%),
      radial-gradient(70% 60% at 100% 0%, rgb(26 44 70 / 0.5), transparent 60%),
      linear-gradient(to bottom, var(--tile-a), var(--tile-b));
    container-type: inline-size;
    --rail: 56px;
  }

  .pcol { position: relative; display: flex; flex: 0 0 var(--rail); min-width: 0; transition: flex-basis 0.8s var(--ease); }
  .pcol[aria-expanded="true"] { flex-basis: calc(100cqw - 2 * var(--rail)); }
  .pcol + .pcol { border-left: 1px solid var(--line); }

  .pcol__rail {
    flex: 0 0 var(--rail);
    display: flex; flex-direction: column; align-items: center; gap: 14px;
    padding-block: 22px; color: var(--ink-3); cursor: pointer;
    transition: color 0.3s, background 0.3s;
  }
  .pcol__rail:hover { color: var(--ink); background: rgb(255 255 255 / 0.03); }
  .pcol[aria-expanded="true"] .pcol__rail { color: var(--ink); cursor: default; }
  .pcol[aria-expanded="true"] .pcol__n { color: var(--blue); }
  .pcol__n { font-size: 11px; letter-spacing: 0.12em; font-weight: 500; }
  .pcol__label { writing-mode: vertical-rl; transform: rotate(180deg); font-size: 12px; white-space: nowrap; }

  /* content keeps its final width during the push, so the text never reflows mid-animation */
  .pcol__body { flex: 1; min-width: 0; overflow: hidden; }
  .pcol__inner {
    width: calc(100cqw - 3 * var(--rail));
    display: grid; gap: clamp(32px, 6cqw, 72px);
    padding: clamp(24px, 4cqw, 56px) clamp(20px, 3cqw, 40px) clamp(24px, 4cqw, 56px) clamp(8px, 1.5cqw, 24px);
    opacity: 0; transform: translateX(24px);
    transition: opacity 0.5s var(--ease), transform 0.8s var(--ease);
  }
  .pcol[aria-expanded="true"] .pcol__inner { opacity: 1; transform: none; transition-delay: 0.15s; }
  .pcol__statement { max-width: 22ch; }
  .pcol__lower { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 4fr); gap: clamp(20px, 4cqw, 56px); align-items: end; }
  .pcol__thumb { position: relative; }
  .pcol__thumb .btn { position: absolute; left: 12px; bottom: 12px; z-index: 1; }
  .pcol__lower p { max-width: 34ch; }

  /* phones: stack the columns, rails become headers, open one grows in height */
  @media (max-width: 699px) {
    .practice__panel { flex-direction: column; }
    .pcol { flex: none; flex-direction: column; transition: none; }
    .pcol + .pcol { border-left: 0; border-top: 1px solid var(--line); }
    .pcol__rail { flex: none; flex-direction: row; align-items: center; gap: 12px; padding: 16px; }
    .pcol__label { writing-mode: horizontal-tb; transform: none; }
    .pcol__body { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.6s var(--ease); }
    .pcol[aria-expanded="true"] .pcol__body { grid-template-rows: 1fr; }
    .pcol__body > * { min-height: 0; }
    .pcol__inner { width: auto; padding: 0 16px 20px; transform: translateY(12px); }
    .pcol__lower { grid-template-columns: 1fr; }
  }
</style>
