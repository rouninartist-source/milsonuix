---
import { site, pillars, img } from "../data/site";
import { ui, pick, type Lang } from "../data/i18n";
import Icon from "./Icon.astro";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const portrait = img("milson-portrait", 1600, 2000, true);
---
<section class="hero on-dark" data-hero>
  <div class="hero__media" aria-hidden="true">
    <img src={portrait} alt="" class="is-active" data-backdrop="" fetchpriority="high" />
    {pillars.map((p) => <img src={img(p.seed, 1600, 2000, true)} alt="" data-backdrop={p.id} loading="lazy" />)}
    <div class="hero__scrim"></div>
  </div>

  <div class="container hero__content">
    <p class="hero__tag lede" data-reveal>{pick(site.tagline, lang)}</p>

    <div class="hero__bottom">
      <div class="hero__views" data-reveal style="--delay:120ms">
        <span class="small muted">{t.hero.watch}</span>
        <div class="hero__pills" role="group" aria-label={t.hero.topics}>
          {pillars.map((p) => (
            <button type="button" class="pill" data-topic={p.id} aria-pressed="false">
              <Icon name="play" class="pill__play" />
              <Icon name="pause" class="pill__pause" />
              {pick(p.short, lang)}
            </button>
          ))}
        </div>
      </div>

      <div class="hero__giant" aria-hidden="true">
        <p class="hero__name display" style={`--chars:${site.person.length}`}>
          {site.person.split(" ").map((w, i) => <>{i > 0 && " "}<span>{w}</span></>)}
        </p>
        <div class="hero__strip display">
          <div class="hero__track">
            {[0, 1].map(() => pillars.map((p) => <span data-word={p.id}>{pick(p.short, lang).replace("/", "·")}</span>))}
          </div>
        </div>
      </div>

      <div class="hero__meta small">
        <span class="hero__clock" data-clock></span>
        <span class="hero__mute"><Icon name="mute" size={14} /></span>
      </div>
    </div>
  </div>

  <h1 class="sr-only">{site.brand} — {pick(site.role, lang)}</h1>
</section>

<style>
  .hero { position: relative; min-height: 100svh; display: flex; flex-direction: column; overflow: hidden; background: var(--obsidian); }
  .hero__media { position: absolute; inset: 0; }
  .hero__media img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 12%;
    opacity: 0; transform: scale(1.04);
    transition: opacity 1.2s var(--ease), transform 6s var(--ease);
  }
  .hero__media img.is-active { opacity: 1; transform: none; }
  .hero__scrim {
    position: absolute; inset: 0;
    background:
      linear-gradient(to bottom, rgb(6 9 16 / 0.55) 0%, rgb(6 9 16 / 0) 28%, rgb(6 9 16 / 0.25) 58%, var(--hero-end) 100%),
      radial-gradient(90% 70% at 50% 40%, transparent 40%, rgb(6 9 16 / 0.55) 100%);
  }
  .hero__content { position: relative; z-index: 1; flex: 1; display: flex; flex-direction: column; padding-top: calc(var(--nav-h) + 24px); }
  .hero__tag { max-width: 15ch; color: var(--ink); }
  @media (min-width: 900px) {
    .hero__tag { margin-left: auto; margin-top: 6vh; width: calc((100% - 11 * var(--gutter)) / 12 * 4 + 3 * var(--gutter)); max-width: none; }
  }

  .hero__bottom { margin-top: auto; padding-bottom: 20px; }
  .hero__views { display: grid; gap: 10px; margin-bottom: 18px; }
  .hero__pills { display: flex; flex-wrap: wrap; gap: 6px; }
  .pill {
    display: inline-flex; align-items: center; gap: 7px; height: 34px; padding-inline: 12px 14px;
    border: 1px solid var(--btn-border); border-radius: 999px;
    font-size: 12px; font-weight: 500; color: var(--ink);
    background: var(--btn-bg); backdrop-filter: blur(8px);
    transition: background 0.3s var(--ease), border-color 0.3s var(--ease), color 0.3s var(--ease);
  }
  .pill :global(svg) { width: 11px; height: 11px; }
  .pill:hover { border-color: var(--ink); }
  .pill.is-active { background: var(--ink); color: var(--bg); border-color: var(--ink); }

  /* Giant text: the name at rest, the topic strip while a pill plays. */
  /* The name fills the width in one line on desktop; on phones it breaks into two lines. */
  .hero__giant { position: relative; overflow: hidden; margin-inline: calc(var(--margin) * -1); padding-inline: var(--margin); }
  .hero__name,
  .hero__strip { transition: opacity 0.6s var(--ease), transform 0.8s var(--ease); }
  .hero__name { position: relative; font-size: min(calc((100vw - 2 * var(--margin)) / (var(--chars) * 0.56)), 236px); white-space: nowrap; color: var(--ink); }
  .hero__name span { display: inline-block; }
  @media (max-width: 699px) {
    .hero__name { font-size: min(21.5vw, 120px); }
    .hero__name span { display: block; margin: 0; }
  }
  .hero__strip { position: absolute; inset: 0 auto auto 0; width: 100%; padding-inline: var(--margin); font-size: clamp(76px, 15.5vw, 236px); opacity: 0; transform: translateY(12%); white-space: nowrap; }
  .hero__track { display: inline-flex; gap: 0.35em; will-change: transform; }
  .hero__track span { color: var(--ink-4); transition: color 0.5s var(--ease); }
  .hero__track span.is-active { color: var(--blue); }
  .hero.is-playing .hero__name { opacity: 0; transform: translateY(-12%); }
  .hero.is-playing .hero__strip { opacity: 1; transform: none; }
  .hero.is-playing .hero__track { animation: marquee 28s linear infinite; }
  @keyframes marquee { to { transform: translateX(-50%); } }

  .hero__meta { display: flex; justify-content: space-between; align-items: center; min-height: 20px; margin-top: 10px; color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .hero__mute { opacity: 0; transition: opacity 0.4s; }
  .hero.is-playing .hero__mute { opacity: 0.8; }
</style>
