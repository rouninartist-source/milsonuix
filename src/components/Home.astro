---
import { site, img, pick, type Lang } from "../data/site";
import { content } from "../data/content";
import Hero from "./Hero.astro";
import Bleed from "./Bleed.astro";
import SectionRule from "./SectionRule.astro";
import Icon from "./Icon.astro";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
const fill = (s: string) => s.replace("{size}", site.portfolioSize).replace("{email}", site.email);
---
<Hero lang={lang} />

<!-- ─── 01 About ─── -->
<section id="about" class="container section about" data-spy-section>
  <SectionRule n="01" label={t.about.label} />
  <div class="grid about__grid">
    <div class="about__media duotone fade-edges" data-reveal>
      <img src={img("mushin-about", 900, 1100, true)} alt="Mushin Designer, portrait" loading="lazy" />
    </div>
    <div class="about__text">
      <div>
        <p class="eyebrow about__title" data-reveal>{t.about.title}</p>
        <p class="statement--lg" data-reveal>{t.about.statement}</p>
      </div>
      <div class="about__aside" data-reveal style="--delay:120ms">
        {t.about.body.map((p) => <p class="small body">{p}</p>)}
        <a href={site.resume} class="btn btn--sm" download><Icon name="enter" />{t.about.resume}</a>
      </div>
    </div>
    <ul class="about__metrics" data-reveal>
      {t.about.metrics.map((m) => (
        <li><span class="display about__num">{m.value}</span><span class="small muted">{m.label}</span></li>
      ))}
    </ul>
  </div>
</section>

<!-- ─── 02 Experience ─── -->
<section id="experience" class="container section--tight xp">
  <SectionRule n="02" label={t.experience.label} />
  <h2 class="statement xp__title" data-reveal>{t.experience.title}</h2>
  <ol class="xp__list">
    {site.experience.map((e, i) => (
      <li class="xp__row" data-reveal style={`--delay:${i * 60}ms`}>
        <span class="xp__years small">{e.from} — {pick(e.to, lang)}</span>
        <span class="xp__company lede">{e.company}</span>
        <span class="xp__role small body">{pick(e.role, lang)}</span>
      </li>
    ))}
  </ol>
</section>

<!-- ─── 03 Skills ─── -->
<section id="skills" class="container section--tight skills">
  <SectionRule n="03" label={t.skills.label} />
  <h2 class="statement skills__title" data-reveal>{t.skills.title}</h2>
  <ul class="skills__grid">
    {site.skills.map((s, i) => (
      <li class="skill" data-reveal style={`--delay:${(i % 5) * 50}ms`}>
        <span class="skill__tool">{s.tool}</span>
        <span class="skill__tag small muted">{pick(s.tag, lang)}</span>
      </li>
    ))}
  </ul>
</section>

<Bleed src={img("mushin-bleed", 2000, 900)} alt="" />

<!-- ─── 04 Selected work ─── -->
<section id="work" class="container section work" data-spy-section>
  <SectionRule n="04" label={t.work.label} />
  <div class="grid work__grid">
    <div class="work__head">
      <h2 class="statement--lg" data-reveal>{t.work.title}</h2>
      <p class="lede body work__intro" data-reveal style="--delay:100ms">{t.work.intro}</p>
    </div>
    <div class="work__soon" data-reveal>
      <p class="display work__soon-word"><span class="masked" style={`background-image:url(${img("mushin-soon", 1800, 800)})`}>{t.work.soon}</span></p>
      <p class="small body work__soon-body">{t.work.soonBody}</p>
    </div>
    <div class="work__book" data-reveal style="--delay:120ms">
      <div class="work__book-cover media media--portrait">
        <img src={img("mushin-book", 800, 1000)} alt="" loading="lazy" />
        <span class="chip chip--dot work__book-chip">{site.portfolioSize}</span>
      </div>
      <div class="work__book-text">
        <p class="eyebrow">{t.work.bookLabel}</p>
        <p class="small body">{fill(t.work.bookNote)}</p>
        <div class="work__book-actions">
          <a href={site.portfolio} class="btn btn--primary btn--sm" target="_blank" rel="noopener"><Icon name="arrow" />{t.work.open}</a>
          <a href={site.portfolio} class="btn btn--sm" download><Icon name="enter" />{t.work.download}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ─── 05 Services ─── -->
<section id="services" class="container section services" data-spy-section>
  <SectionRule n="05" label={t.services.label} />
  <h2 class="statement services__title" data-reveal>{t.services.title}</h2>
  <ol class="services__list">
    {t.services.items.map((s, i) => (
      <li class="service" data-reveal style={`--delay:${(i % 2) * 80}ms`}>
        <span class="service__n display">{s.n}</span>
        <span class="service__text">
          <span class="service__title lede">{s.title}</span>
          <span class="service__body small body">{s.body}</span>
        </span>
      </li>
    ))}
  </ol>
</section>

<!-- ─── 06 Process ─── -->
<section id="process" class="process" data-spy-section>
  <div class="container section" data-tabs data-active="01">
    <SectionRule n="06" label={t.process.label} />
    <h2 class="statement--lg process__title" data-reveal>{t.process.title}</h2>
    <div class="process__stage">
      {t.process.steps.map((s) => (
        <article class="process__panel grid" data-panel={s.n} hidden>
          <p class="process__big display" aria-hidden="true">{s.n}</p>
          <div class="process__text">
            <p class="eyebrow">{s.n} · {s.title}</p>
            <p class="statement">{s.line}</p>
            <p class="small body">{s.body}</p>
          </div>
        </article>
      ))}
    </div>
    <div class="process__timeline" role="tablist">
      <span class="process__bar" data-progress aria-hidden="true"></span>
      {t.process.steps.map((s) => (
        <button type="button" role="tab" class="process__tab" data-tab={s.n} aria-selected="false">
          <span class="process__tab-n">{s.n}</span><span class="process__tab-t">{s.title}</span>
        </button>
      ))}
    </div>
  </div>
</section>

<!-- ─── Manifesto ─── -->
<section class="container section manifesto">
  <p class="manifesto__text statement--lg fade-words">{t.manifesto.line1} {t.manifesto.line2}</p>
  <p class="eyebrow manifesto__by" data-reveal>— {t.manifesto.by}</p>
</section>

<!-- ─── 07 Voices + Trusted by ─── -->
<section id="voices" class="container section--tight voices" data-spy-section>
  <SectionRule n="07" label={t.voices.label} />
  <h2 class="statement voices__title" data-reveal>{t.voices.title}</h2>
  <div class="voices__grid">
    {t.voices.items.map((v, i) => (
      <figure class="voice" data-reveal style={`--delay:${i * 100}ms`}>
        <blockquote class="lede">“{v.quote}”</blockquote>
        <figcaption class="small"><span class="voice__name">{v.name}</span><span class="muted">{v.role}</span></figcaption>
      </figure>
    ))}
  </div>
  <p class="eyebrow trusted__label">{t.voices.trusted}</p>
</section>
<div class="trusted" aria-label={t.voices.trusted}>
  <div class="trusted__track display">
    {[0, 1].map(() => site.trustedBy.map((b) => <span>{b}</span>))}
  </div>
</div>

<!-- ─── 08 Visual lab ─── -->
<section id="lab" class="container section lab">
  <SectionRule n="08" label={t.lab.label} />
  <div class="grid lab__grid">
    <div class="lab__text">
      <h2 class="statement--lg" data-reveal>{t.lab.title}</h2>
      <p class="small body" data-reveal style="--delay:100ms">{t.lab.body}</p>
    </div>
    <ul class="lab__tiles" data-reveal style="--delay:150ms">
      {["grid", "ring", "dots", "grid"].map((k, i) => (
        <li class="lab__tile"><span class={`lab__icon lab__icon--${k}`} aria-hidden="true"></span><span class="small muted">{t.lab.soon} · {String(i + 1).padStart(2, "0")}</span></li>
      ))}
    </ul>
  </div>
</section>

<!-- ─── 09 Contact ─── -->
<section id="contact" class="container section contact" data-spy-section>
  <SectionRule n="09" label={t.contact.label} />
  <div class="grid contact__grid">
    <div class="contact__side">
      <h2 class="statement--lg" data-reveal>{t.contact.title}</h2>
      <div data-reveal style="--delay:100ms">
        <p class="eyebrow">{t.contact.openTo}</p>
        <ul class="contact__focus small">
          {t.contact.focus.map((f) => <li><span class="contact__dot"></span>{f}</li>)}
        </ul>
      </div>
      <div data-reveal style="--delay:160ms">
        <p class="eyebrow">{t.contact.channels}</p>
        <ul class="contact__socials">
          {site.socials.map((s) => (
            <li><a href={s.href} target="_blank" rel="noopener" class="small"><Icon name={s.short as "li"} />{s.label}</a></li>
          ))}
          <li><a href={`mailto:${site.email}`} class="small"><Icon name="arrow" />{site.email}</a></li>
        </ul>
      </div>
    </div>

    <form class="contact__form" data-contact={site.email} novalidate data-reveal style="--delay:120ms">
      <div class="field">
        <label for="c-name" class="eyebrow">{t.contact.fields.name}</label>
        <input id="c-name" name="name" type="text" required autocomplete="name" />
      </div>
      <div class="field">
        <label for="c-email" class="eyebrow">{t.contact.fields.email}</label>
        <input id="c-email" name="email" type="email" required autocomplete="email" />
      </div>
      <div class="field">
        <label for="c-msg" class="eyebrow">{t.contact.fields.project}</label>
        <textarea id="c-msg" name="message" rows="5" required placeholder={t.contact.fields.projectPlaceholder}></textarea>
      </div>
      <button type="submit" class="btn btn--primary"><Icon name="arrow" />{t.contact.send} →</button>
      <p class="small blue" data-sent hidden>{fill(t.contact.sent)}</p>
    </form>
  </div>
</section>

<style>
  /* About */
  .about__grid { margin-top: clamp(28px, 4vw, 56px); row-gap: 32px; }
  .about__media { grid-column: 1 / -1; aspect-ratio: 4 / 5; max-width: 320px; border-radius: var(--radius); overflow: hidden; }
  .about__media img { width: 100%; height: 100%; object-fit: cover; }
  .about__text { grid-column: 1 / -1; display: grid; gap: 28px; }
  .about__title { margin-bottom: 16px; }
  .about__aside { display: grid; gap: 14px; max-width: 36ch; justify-items: start; }
  .about__metrics { grid-column: 1 / -1; display: flex; gap: 40px; padding-top: 24px; border-top: 1px solid var(--line); }
  .about__metrics li { display: grid; gap: 4px; }
  .about__num { font-size: clamp(48px, 6vw, 88px); line-height: 0.9; color: var(--blue); }
  @media (min-width: 900px) {
    .about__media { grid-column: 1 / span 3; max-width: none; }
    .about__text { grid-column: 5 / -1; grid-template-columns: 7fr 4fr; gap: var(--gutter); align-items: start; }
    .about__aside { padding-top: 0.6em; }
    .about__metrics { grid-column: 5 / -1; }
  }

  /* Experience */
  .xp__title, .skills__title, .services__title, .voices__title { margin-block: clamp(24px, 3vw, 40px); max-width: 24ch; }
  .xp__list { border-top: 1px solid var(--line); }
  .xp__row { display: grid; gap: 4px 24px; padding-block: 18px; border-bottom: 1px solid var(--line); transition: padding-left 0.4s var(--ease); }
  .xp__row:hover { padding-left: 8px; }
  .xp__row:hover .xp__company { color: var(--blue); }
  .xp__years { color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .xp__company { transition: color 0.3s; }
  @media (min-width: 700px) { .xp__row { grid-template-columns: 160px 1fr 1fr; align-items: baseline; } }

  /* Skills */
  .skills__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gutter); }
  .skill { display: grid; gap: 14px; align-content: space-between; aspect-ratio: 1 / 0.8; padding: 16px; border: 1px solid var(--line); border-radius: var(--radius);
    background: linear-gradient(to bottom, rgb(26 44 70 / 0.16), rgb(6 9 16 / 0.4)); transition: border-color 0.3s, background 0.3s; }
  .skill:hover { border-color: rgb(232 234 250 / 0.3); background: linear-gradient(to bottom, rgb(0 112 255 / 0.16), rgb(6 9 16 / 0.5)); }
  .skill__tool { font-size: 15px; font-weight: 500; }
  @media (min-width: 700px) { .skills__grid { grid-template-columns: repeat(5, minmax(0, 1fr)); } }

  /* Work */
  .work__grid { margin-top: clamp(28px, 4vw, 56px); row-gap: 40px; }
  .work__head { grid-column: 1 / -1; display: grid; gap: 16px; }
  .work__intro { max-width: 40ch; }
  .work__soon { grid-column: 1 / -1; display: grid; gap: 16px; }
  .work__soon-word { font-size: min(calc((100vw - 2 * var(--margin)) / 6.2), 330px); line-height: 0.84; overflow: hidden; margin-inline: -0.03em; }
  .work__soon-word .masked { padding-inline: 0.03em; }
  .work__soon-body { max-width: 44ch; }
  .work__book { grid-column: 1 / -1; display: grid; gap: 20px; align-items: end; }
  .work__book-cover { max-width: 280px; }
  .work__book-chip { position: absolute; top: 12px; left: 12px; }
  .work__book-text { display: grid; gap: 12px; max-width: 40ch; }
  .work__book-actions { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
  @media (min-width: 900px) {
    .work__head { grid-column: 1 / span 7; }
    .work__soon { grid-column: 1 / -1; }
    .work__book { grid-column: 1 / -1; grid-template-columns: 3fr 6fr 3fr; }
    .work__book-cover { grid-column: 1; max-width: none; }
    .work__book-text { grid-column: 2; }
  }

  /* Services */
  .services__list { display: grid; border-top: 1px solid var(--line); }
  .service { display: grid; grid-template-columns: 64px 1fr; gap: 16px; padding-block: 22px; border-bottom: 1px solid var(--line); }
  .service__n { font-size: 36px; line-height: 0.9; color: var(--ink-4); transition: color 0.3s; }
  .service:hover .service__n { color: var(--blue); }
  .service__text { display: grid; gap: 8px; max-width: 48ch; }
  @media (min-width: 900px) {
    .services__list { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--gutter); }
    .service { grid-template-columns: 88px 1fr; padding-block: 28px; }
    .service__n { font-size: 48px; }
  }

  /* Process */
  .process { background: linear-gradient(to bottom, var(--bg), var(--bg-2) 50%, var(--bg)); }
  .process__title { margin-top: clamp(24px, 3vw, 40px); max-width: 16ch; }
  .process__stage { position: relative; margin-top: clamp(24px, 4vw, 56px); min-height: 260px; }
  .process__panel { row-gap: 20px; align-items: center; }
  .process__big { grid-column: 1 / -1; font-size: clamp(120px, 24vw, 340px); line-height: 0.8; color: rgb(26 44 70 / 0.5); user-select: none; }
  .process__text { grid-column: 1 / -1; display: grid; gap: 14px; max-width: 40ch; }
  @media (min-width: 900px) {
    .process__big { grid-column: 1 / span 5; }
    .process__text { grid-column: 7 / span 6; }
  }
  .process__timeline { position: relative; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); margin-top: 40px; padding-top: 14px; }
  .process__timeline::before { content: ""; position: absolute; left: 0; right: 0; bottom: 3px; height: 1px; background: var(--line); }
  .process__bar { position: absolute; left: 0; bottom: 3px; height: 1px; width: calc(var(--p, 0) * 100%); background: var(--blue); transition: width 0.6s var(--ease); }
  .process__tab { position: relative; display: grid; gap: 2px; justify-items: start; padding-bottom: 16px; font-size: 12px; color: var(--ink-3); transition: color 0.3s; text-align: left; }
  .process__tab-n { font-size: 10px; letter-spacing: 0.1em; }
  .process__tab::after { content: ""; position: absolute; left: 0; bottom: 0; width: 7px; height: 7px; border-radius: 50%; background: var(--ink-4); transition: background 0.3s; }
  .process__tab:last-child { justify-items: end; text-align: right; }
  .process__tab:last-child::after { left: auto; right: 0; }
  .process__tab.is-reached { color: var(--blue); }
  .process__tab.is-reached::after { background: var(--blue); }
  .process__tab.is-active, .process__tab:hover { color: var(--frost); }
  @media (max-width: 599px) { .process__tab-t { display: none; } .process__tab.is-active .process__tab-t { display: block; } }

  /* Manifesto */
  .manifesto { text-align: center; }
  .manifesto__text { max-width: 24ch; margin-inline: auto; }
  .manifesto__by { margin-top: 28px; }

  /* Voices */
  .voices__grid { display: grid; gap: var(--gutter); }
  .voice { margin: 0; display: grid; gap: 22px; padding: 24px; border: 1px solid var(--line); border-radius: var(--radius); background: linear-gradient(to bottom, rgb(26 44 70 / 0.16), rgb(6 9 16 / 0.4)); }
  .voice blockquote { margin: 0; text-wrap: pretty; }
  .voice figcaption { display: grid; gap: 2px; }
  .voice__name { font-weight: 500; }
  @media (min-width: 800px) { .voices__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .trusted__label { margin-top: clamp(40px, 6vw, 72px); }
  .trusted { overflow: hidden; padding-block: 16px 8px; -webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent); mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent); }
  .trusted__track { display: inline-flex; gap: 0.9em; white-space: nowrap; font-size: clamp(30px, 4.2vw, 60px); color: rgb(232 234 250 / 0.28); animation: trusted 70s linear infinite; }
  .trusted__track span { transition: color 0.3s; }
  .trusted__track span:hover { color: var(--frost); }
  .trusted__track span + span::before { content: "·"; margin-right: 0.9em; color: rgb(232 234 250 / 0.14); }
  @keyframes trusted { to { transform: translateX(-50%); } }

  /* Lab */
  .lab__grid { margin-top: clamp(28px, 4vw, 56px); row-gap: 32px; }
  .lab__text { grid-column: 1 / -1; display: grid; gap: 16px; max-width: 44ch; }
  .lab__tiles { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--gutter); }
  .lab__tile { display: grid; gap: 18px; align-content: end; aspect-ratio: 1; padding: 16px; border: 1px solid var(--line); border-radius: var(--radius); color: var(--ink-3);
    background: linear-gradient(to bottom, rgb(26 44 70 / 0.16), rgb(6 9 16 / 0.5)); transition: color 0.3s, border-color 0.3s; }
  .lab__tile:hover { color: var(--frost); border-color: rgb(232 234 250 / 0.3); }
  .lab__icon { width: 48px; height: 48px; }
  .lab__icon--grid { background: radial-gradient(circle, currentColor 1.3px, transparent 1.5px) 0 0 / 9px 9px; }
  .lab__icon--dots { background: radial-gradient(circle, currentColor 1.6px, transparent 1.8px) 0 0 / 14px 14px; }
  .lab__icon--ring { border-radius: 50%; background: radial-gradient(circle, currentColor 1.4px, transparent 1.6px) 0 0 / 8px 8px;
    -webkit-mask: radial-gradient(circle, transparent 38%, #000 40%, #000 62%, transparent 64%); mask: radial-gradient(circle, transparent 38%, #000 40%, #000 62%, transparent 64%); }
  @media (min-width: 900px) {
    .lab__text { grid-column: 1 / span 5; }
    .lab__tiles { grid-column: 7 / -1; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  /* Contact */
  .contact__grid { margin-top: clamp(28px, 4vw, 56px); row-gap: 48px; }
  .contact__side { grid-column: 1 / -1; display: grid; gap: 32px; align-content: start; }
  .contact__side h2 { max-width: 16ch; }
  .contact__focus { display: grid; gap: 8px; margin-top: 12px; }
  .contact__focus li { display: flex; align-items: center; gap: 10px; color: var(--ink-2); }
  .contact__dot { width: 5px; height: 5px; border-radius: 50%; background: var(--blue); }
  .contact__socials { display: grid; gap: 6px; margin-top: 12px; }
  .contact__socials a { display: inline-flex; align-items: center; gap: 8px; color: var(--ink-2); transition: color 0.3s; }
  .contact__socials a:hover { color: var(--frost); }
  .contact__form { grid-column: 1 / -1; display: grid; gap: 22px; justify-items: start; }
  .field { display: grid; gap: 8px; width: 100%; }
  .field input, .field textarea { width: 100%; padding: 12px 0; border: 0; border-bottom: 1px solid var(--line); background: transparent; color: var(--frost); border-radius: 0; transition: border-color 0.3s; resize: vertical; }
  .field input:focus, .field textarea:focus { outline: 0; border-color: var(--blue); }
  .field textarea::placeholder { color: var(--ink-3); }
  @media (min-width: 900px) {
    .contact__side { grid-column: 1 / span 5; }
    .contact__form { grid-column: 7 / span 6; }
  }
</style>
