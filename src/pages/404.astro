---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
---
<Base title="Not found" noFooter>
  <section class="container nf">
    <p class="display nf__code">404</p>
    <p class="lede">That page isn't here.</p>
    <Button href="/" icon="arrow">Back home</Button>
  </section>
</Base>

<style>
  .nf { min-height: 100svh; display: grid; align-content: center; justify-items: start; gap: 20px; padding-top: var(--nav-h); }
  .nf__code { font-size: clamp(120px, 28vw, 360px); line-height: 0.8; color: var(--navy); }
</style>
